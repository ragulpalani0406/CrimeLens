# CrimeLens — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to version control.

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/crimelens?retryWrites=true&w=majority

# JWT signing secret — use a long, random string (32+ chars)
JWT_SECRET=replace-with-a-long-random-secret-string

# Server environment
NODE_ENV=development
